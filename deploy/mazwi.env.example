# Settings for a hosted Mazwi (set them as environment variables for the API process; never commit real values).
ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__Mazwi=Host=localhost;Database=mazwi;Username=mazwi;Password=change-me
MediaStorage__Root=/srv/mazwi/media
Mazwi__Hosted=true
# Next.js connects to the API from this address; only it may pass on the visitor's address and https.
Mazwi__TrustedProxies=127.0.0.1
Mazwi__PublicBaseUrl=https://mazwi.example
Mazwi__OutboxPath=/srv/mazwi/outbox
# Confirmed accounts with these emails can moderate reports.
Mazwi__Moderators=moderator@mazwi.example
OPENAI_API_KEY=
# Story Twins: off by default. When on, every published story costs two OpenAI calls (a private gist and an embedding).
Mazwi__Twins__Enabled=false
# Uncalibrated starting point; tune with real stories (see docs/story-twins.md).
Mazwi__Twins__Threshold=0.8
