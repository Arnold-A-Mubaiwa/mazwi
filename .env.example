# Copy to ignored .env, or set these in your process environment.
# Supply your own local PostgreSQL development and dedicated *_tests database settings.
ConnectionStrings__Mazwi=
MAZWI_TEST_CONNECTION_STRING=
# Only needed for the optional Docker Compose profile:
POSTGRES_PASSWORD=
# Passwords for the stable browser-test fixture accounts; choose any 10-128 characters.
MAZWI_E2E_ARTIST_PASSWORD=
MAZWI_E2E_OTHER_ARTIST_PASSWORD=
