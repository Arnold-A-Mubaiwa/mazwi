# Copy to ignored .env, or set these in your process environment.
# Two different local PostgreSQL databases: the app one (for example Database=mazwi) and a dedicated one ending in _tests.
# The API refuses to run the app against a *_tests database. Migrations create the app database if it is missing.
ConnectionStrings__Mazwi=
MAZWI_TEST_CONNECTION_STRING=
# Only needed for the optional Docker Compose profile:
POSTGRES_PASSWORD=
# Passwords for the stable browser-test fixture accounts; choose any 10-128 characters.
MAZWI_E2E_ARTIST_PASSWORD=
MAZWI_E2E_OTHER_ARTIST_PASSWORD=
# Optional: AI transcripts, translations and voices. Without it, artists write their own words.
OPENAI_API_KEY=
